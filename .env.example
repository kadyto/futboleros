# Puerto en el servidor. La aplicación escucha en el puerto 8000 dentro del contenedor.
APP_PORT=8093
# Para acceso desde la red local. Usa 127.0.0.1 si solo se accederá mediante un proxy local.
BIND_ADDRESS=0.0.0.0

# Obligatoria: define tu propia contraseña de administración (al menos 12 caracteres).
ADMIN_PASSWORD=
# auto marca la cookie como Secure si la petición llega por HTTPS.
COOKIE_SECURE=auto

# Estadísticas: sin proxy, deja vacío. Para Cloudflare delante de un proxy local:
# ANALYTICS_TRUST_PROXY=cloudflare
# También admite IP o rangos CIDR de proxies de confianza, separados por comas.
ANALYTICS_TRUST_PROXY=
